{
  "name": "babyboel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "pnpm format:check && pnpm lint && pnpm validate:config && pnpm validate:migrations && pnpm cf-typegen:check && pnpm typecheck && pnpm test && pnpm build",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "pnpm cf-typegen && git diff --exit-code -- worker-configuration.d.ts",
    "validate:config": "tsx scripts/validate-config.ts",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "dev:scheduled": "vite dev",
    "deploy:preview": "CLOUDFLARE_ENV=preview pnpm build && CLOUDFLARE_ENV=preview wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm build && CLOUDFLARE_ENV=production wrangler deploy"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@eslint/js": "latest",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vitejs/plugin-react": "latest",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "jsdom": "^30.0.1",
    "jsonc-parser": "^3.3.1",
    "miniflare": "3.20250718.3",
    "prettier": "latest",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
